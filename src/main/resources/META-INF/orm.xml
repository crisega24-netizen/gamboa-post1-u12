<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mapeo JPA de SolicitudReembolso en XML, en lugar de anotaciones @Entity en la clase.
  Asi el paquete dominio no importa nada de jakarta.persistence (checkpoint del Paso 1)
  y aun asi Spring Data JPA puede persistirla. JPA carga META-INF/orm.xml automaticamente.
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_0.xsd"
                 version="3.0">

    <entity class="com.empresa.reembolsos.dominio.SolicitudReembolso" access="FIELD">
        <table name="solicitud_reembolso"/>
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="empleadoId" optional="false"/>
            <basic name="categoria" optional="false">
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="montoSolicitado" optional="false"/>
            <basic name="fechaGasto" optional="false"/>
            <basic name="estado" optional="false">
                <enumerated>STRING</enumerated>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
